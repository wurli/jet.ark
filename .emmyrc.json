{
  "diagnostics": {
    "disable": [
      "unnecessary-if"
    ]
  },
  "runtime": {
    "requirePattern": [
      "?/init.lua",
      "?.lua"
    ],
    "version": "LuaJIT"
  },
  "workspace": {
    "ignoreDir": [
      "target",
      "deps",
      "debug"
    ],
    "ignoreGlobs": [
      "*.log"
    ],
    "library": [
      "$VIMRUNTIME",
      "./deps"
    ]
  }
}
